# Vault Distributed Storage — Environment Variables
# Copy this file to .env.local and fill in values as needed.

# Node JS port (default 3001)
PORT=3001

# VAULT storage root directory (defaults to ./storage)
VAULT_STORAGE_PATH=./storage

# Default replication factor (1–8)
VAULT_DEFAULT_REPLICATION_FACTOR=3

# Per-node capacity in bytes (default 2 GB)
VAULT_CAPACITY_PER_NODE_BYTES=2147483648
